<mujoco model="pendulum">

  <!-- inertiafromgeom="auto" so the explicit <inertial> below is used instead of
       being recomputed from the geoms -->
  <compiler angle="radian" inertiafromgeom="auto"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <joint damping="0.00001" armature="0" limited="false"/>
    <geom rgba="0.3 0.6 0.9 1"/>
    <motor ctrlrange="-5 5" gear="1"/>
  </default>

  <worldbody>
    <light pos="2 2 3" dir="-1 -1 -2"/>
    <body name="pendulum" pos="0 0 0">
      <joint name="hinge" type="hinge" axis="0 1 0"/>

      <!-- point mass m at distance L from the pivot: all the mass sits at the tip
           and it has no inertia of its own, so I about the hinge is exactly m L^2 -->
      <inertial pos="0 0 -1" mass="1.0" diaginertia="1e-9 1e-9 1e-9"/>

      <!-- massless geoms, for visualization only -->
      <geom name="rod" type="capsule" fromto="0 0 0  0 0 -1" size="0.015" mass="0"
            contype="0" conaffinity="0"/>
      <geom name="bob" type="sphere" pos="0 0 -1" size="0.06" mass="0"
            contype="0" conaffinity="0" rgba="1 0.3 0.3 1"/>
      <site name="tip" pos="0 0 -1" size="0.02" rgba="1 0.3 0.3 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="torque" joint="hinge"/>
  </actuator>

  <sensor>
    <jointpos name="theta" joint="hinge"/>
    <jointvel name="thetadot" joint="hinge"/>
    <actuatorfrc name="tau" actuator="torque"/>
  </sensor>

</mujoco>
